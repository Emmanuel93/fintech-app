# ── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
build/
.packages
.pub-cache/
.pub/
coverage/
*.dart.js
*.info.json
doc/api/

# Generados por `melos bootstrap` en cada paquete: reescriben las dependencias
# de path a la copia local, así que son de la máquina, no del proyecto.
pubspec_overrides.yaml

# Los lockfiles de los paquetes **de librería** no se versionan (convención de
# Dart: sólo las aplicaciones fijan sus versiones). Aquí además los reescribe
# `melos bootstrap` en cada arranque, así que versionarlos era garantizar un
# conflicto por cada cambio de dependencia, en nueve archivos a la vez.
# Se conservan los dos que sí mandan sobre la build: el de la raíz y el de
# fa_shell, que es la aplicación.
packages/*/pubspec.lock
!packages/fa_shell/pubspec.lock

